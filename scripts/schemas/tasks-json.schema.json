{
  "type": "object",
  "required": ["tasks"],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "plan_with_file": { "type": "boolean" },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["task_id", "title", "goal", "allowed_files", "forbidden_files", "expected_files", "acceptance_criteria", "trace_refs", "change_point_refs", "behavior_invariants", "impact_surface", "context_to_load", "risk_level", "rollback"],
        "properties": {
          "task_id": { "type": "string" },
          "title": { "type": "string" },
          "goal": { "type": "string" },
          "description": { "type": "string" },
          "task_complexity": { "type": "string" },
          "allowed_files": { "type": "array" },
          "forbidden_files": { "type": "array" },
          "expected_files": { "type": "array" },
          "acceptance_criteria": { "type": "array", "minItems": 1 },
          "trace_refs": { "type": "array", "minItems": 1 },
          "change_point_refs": { "type": "array", "minItems": 1 },
          "behavior_invariants": { "type": "array", "minItems": 1 },
          "impact_surface": { "type": "object" },
          "context_to_load": { "type": "object" },
          "risk_level": { "type": "string", "enum": ["low", "medium", "high"] },
          "rollback": { "type": "string" },
          "file_plan": { "type": "array" },
          "dependencies": { "type": "array" },
          "depends_on": { "type": "array" }
        }
      }
    }
  }
}

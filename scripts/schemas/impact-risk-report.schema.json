{
  "type": "object",
  "required": ["schema_version", "change_points"],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "change_points": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string" },
          "description": { "type": "string" },
          "risk_level": { "type": "string", "enum": ["low", "medium", "high", "critical"] }
        }
      }
    },
    "flow_graph": { "type": "object" }
  }
}
